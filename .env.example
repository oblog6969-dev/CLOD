# Use a long random value in deployed or multi-instance environments.
# Provider API keys are entered by the user in the app and are never placed here.
LIFEOS_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional: enables the on-demand "Translate your writing" tool in Settings.
# Create a restricted key for Cloud Translation - Basic (v2); never expose it to the browser.
# GOOGLE_TRANSLATE_API_KEY=your-google-cloud-translation-api-key

# Optional and security-sensitive: permit custom AI URLs on private networks.
# LIFEOS_ALLOW_PRIVATE_AI_ENDPOINTS=true
